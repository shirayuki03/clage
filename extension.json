{
  "name": "Clage",
  "version": "0.1.0",
  "description": "ClambonでCanvasゲームを作る拡張機能",
  "grammar": "grammar.lark",
  "python": "main.py",
  "syntaxHighlighting": {
    "keywords": {
      "motion": ["move", "x", "y", "direction"],
      "looks": ["Stage", "Sprite", "costume", "show", "hide"],
      "events": ["run", "start"],
      "control": ["clone"],
      "sensing": ["touching", "pressed"]
    },
    "contexts": [
      {
        "keyword": "delete",
        "prefix": "clone.",
        "category": "control"
      }
    ]
  },
  "ui": {
    "html": "ui.html",
    "css": "ui.css",
    "js": "ui.js",
    "panels": [
      {
        "id": "game",
        "type": "game",
        "title": "ゲーム",
        "defaultSlot": "game"
      }
    ],
    "modes": [
      {
        "id": "code",
        "label": "コード"
      },
      {
        "id": "costume",
        "label": "コスチューム",
        "accept": "image/*",
        "reference": "filename"
      }
    ],
    "costumes": {
      "reference": "filename",
      "duplicates": "error"
    }
  },
  "assets": [],
  "capabilities": ["canvas", "keyboard", "sprites", "costumes"]
}
